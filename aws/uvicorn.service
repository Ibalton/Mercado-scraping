[Unit]
Description=Uvicorn FastAPI app (Mercado-scraping)
After=network.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/Mercado-scraping
ExecStart=/home/ec2-user/Mercado-scraping/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target


